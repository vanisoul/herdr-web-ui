{
	admin off
	auto_https disable_redirects
	skip_install_trust
}

https://{$HERDR_LAN_HOST}:{$HERDR_LAN_HTTPS_PORT} {
	bind {$HERDR_LAN_HOST}
	tls internal
	@outside not remote_ip {$HERDR_LAN_ALLOW}
	respond @outside 403
	reverse_proxy 127.0.0.1:{$HERDR_LAN_BACKEND_PORT} {
		header_up -Tailscale-User-Login
		header_up -Tailscale-Funnel-Request
	}
}
